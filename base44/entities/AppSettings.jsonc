{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Settings key e.g. ai_config"
    },
    "ai_enabled": {
      "type": "boolean",
      "default": true
    },
    "confidence_threshold": {
      "type": "number",
      "default": 75
    },
    "cooldown_minutes": {
      "type": "number",
      "default": 1
    },
    "manual_chat_hours": {
      "type": "number",
      "default": 360,
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e0a\u0e31\u0e48\u0e27\u0e42\u0e21\u0e07\u0e17\u0e35\u0e48 Mute AI \u0e2b\u0e25\u0e31\u0e07\u0e41\u0e2d\u0e14\u0e21\u0e34\u0e19\u0e2a\u0e25\u0e31\u0e1a\u0e40\u0e1b\u0e47\u0e19 Manual Chat (default 360 = 15 \u0e27\u0e31\u0e19)"
    },
    "phone_mute_hours": {
      "type": "number",
      "default": 1,
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e0a\u0e31\u0e48\u0e27\u0e42\u0e21\u0e07\u0e17\u0e35\u0e48\u0e2b\u0e22\u0e38\u0e14 AI \u0e2b\u0e25\u0e31\u0e07\u0e44\u0e14\u0e49\u0e23\u0e31\u0e1a\u0e40\u0e1a\u0e2d\u0e23\u0e4c\u0e42\u0e17\u0e23\u0e08\u0e32\u0e01\u0e25\u0e39\u0e01\u0e04\u0e49\u0e32"
    },
    "schedule_enabled": {
      "type": "boolean",
      "default": false
    },
    "start_time": {
      "type": "string",
      "default": "18:00"
    },
    "end_time": {
      "type": "string",
      "default": "08:00"
    },
    "strict_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0e01\u0e0e\u0e40\u0e02\u0e49\u0e21\u0e07\u0e27\u0e14\u0e17\u0e35\u0e48 AI \u0e15\u0e49\u0e2d\u0e07\u0e1b\u0e0f\u0e34\u0e1a\u0e31\u0e15\u0e34\u0e15\u0e32\u0e21"
    },
    "sla_hours": {
      "type": "number",
      "default": 24,
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e0a\u0e31\u0e48\u0e27\u0e42\u0e21\u0e07 SLA \u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e2a\u0e40\u0e15\u0e15\u0e31\u0e2a\u0e17\u0e35\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e15\u0e34\u0e14\u0e15\u0e32\u0e21"
    },
    "fallback_message": {
      "type": "string",
      "default": "\u0e02\u0e2d\u0e1a\u0e04\u0e38\u0e13\u0e17\u0e35\u0e48\u0e15\u0e34\u0e14\u0e15\u0e48\u0e2d\u0e21\u0e32\u0e04\u0e48\u0e30 \u0e02\u0e13\u0e30\u0e19\u0e35\u0e49\u0e2d\u0e22\u0e39\u0e48\u0e19\u0e2d\u0e01\u0e40\u0e27\u0e25\u0e32\u0e17\u0e33\u0e01\u0e32\u0e23 \u0e40\u0e08\u0e49\u0e32\u0e2b\u0e19\u0e49\u0e32\u0e17\u0e35\u0e48\u0e08\u0e30\u0e23\u0e35\u0e1a\u0e15\u0e34\u0e14\u0e15\u0e48\u0e2d\u0e01\u0e25\u0e31\u0e1a\u0e42\u0e14\u0e22\u0e40\u0e23\u0e47\u0e27\u0e17\u0e35\u0e48\u0e2a\u0e38\u0e14\u0e19\u0e30\u0e04\u0e30 \ud83d\ude4f",
      "description": "\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e15\u0e2d\u0e1a\u0e01\u0e25\u0e31\u0e1a\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34\u0e40\u0e21\u0e37\u0e48\u0e2d AI \u0e16\u0e39\u0e01\u0e1b\u0e34\u0e14\u0e2b\u0e23\u0e37\u0e2d\u0e19\u0e2d\u0e01\u0e40\u0e27\u0e25\u0e32"
    }
  },
  "required": [
    "key"
  ]
}