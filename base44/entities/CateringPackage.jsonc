{
  "name": "CateringPackage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e41\u0e1e\u0e47\u0e01\u0e40\u0e01\u0e08"
    },
    "category": {
      "type": "string",
      "description": "\u0e1b\u0e23\u0e30\u0e40\u0e20\u0e17\u0e41\u0e1e\u0e47\u0e01\u0e40\u0e01\u0e08 \u0e40\u0e0a\u0e48\u0e19 \u0e07\u0e32\u0e19\u0e1a\u0e38\u0e0d, \u0e42\u0e15\u0e4a\u0e30\u0e08\u0e35\u0e19"
    },
    "description": {
      "type": "string",
      "description": "\u0e23\u0e32\u0e22\u0e25\u0e30\u0e40\u0e2d\u0e35\u0e22\u0e14\u0e2d\u0e32\u0e2b\u0e32\u0e23 (\u0e23\u0e2d\u0e07\u0e23\u0e31\u0e1a bullet points)"
    },
    "min_condition": {
      "type": "string",
      "description": "\u0e40\u0e07\u0e37\u0e48\u0e2d\u0e19\u0e44\u0e02\u0e01\u0e32\u0e23\u0e23\u0e31\u0e1a\u0e07\u0e32\u0e19\u0e02\u0e31\u0e49\u0e19\u0e15\u0e48\u0e33"
    },
    "pricing_tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tier_name": {
            "type": "string",
            "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e40\u0e01\u0e23\u0e14/\u0e40\u0e21\u0e19\u0e39 \u0e40\u0e0a\u0e48\u0e19 \u0e40\u0e01\u0e23\u0e14 A (\u0e1e\u0e23\u0e35\u0e40\u0e21\u0e35\u0e22\u0e21)"
          },
          "total_pax": {
            "type": "number"
          },
          "monk_pax": {
            "type": "number"
          },
          "guest_pax": {
            "type": "number"
          },
          "guest_count": {
            "type": "string"
          },
          "price": {
            "type": "string"
          }
        }
      }
    },
    "custom_attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e2b\u0e31\u0e27\u0e02\u0e49\u0e2d \u0e40\u0e0a\u0e48\u0e19 \u0e08\u0e33\u0e19\u0e27\u0e19\u0e42\u0e15\u0e4a\u0e30"
          },
          "value": {
            "type": "string",
            "description": "\u0e04\u0e48\u0e32\u0e15\u0e31\u0e27\u0e40\u0e25\u0e02/\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21 \u0e40\u0e0a\u0e48\u0e19 5"
          }
        }
      },
      "description": "\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e40\u0e15\u0e34\u0e21\u0e41\u0e1a\u0e1a Key-Value \u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a AI"
    },
    "ai_instruction": {
      "type": "string",
      "description": "Instruction \u0e1e\u0e34\u0e40\u0e28\u0e29\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a AI \u0e40\u0e09\u0e1e\u0e32\u0e30\u0e41\u0e1e\u0e47\u0e01\u0e40\u0e01\u0e08\u0e19\u0e35\u0e49"
    },
    "notes": {
      "type": "string",
      "description": "\u0e2b\u0e21\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38/\u0e40\u0e07\u0e37\u0e48\u0e2d\u0e19\u0e44\u0e02\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e40\u0e15\u0e34\u0e21"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e\u0e42\u0e1a\u0e23\u0e0a\u0e31\u0e27\u0e23\u0e4c/\u0e40\u0e21\u0e19\u0e39"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}